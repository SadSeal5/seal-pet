{
  "name": "seal-pet",
  "version": "0.2.2",
  "description": "Pixel art masaüstü fok pet",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/pet.test.mjs",
    "gen": "python tools/gen_sprites.py",
    "gen:friends": "python tools/gen_friends.py",
    "gen:shop": "python tools/gen_shop.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "author": "Sad_Seal",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "minimatch@^5.0.0": "^11.0.8",
    "minimatch@^9.0.0": "^11.0.8",
    "minimatch@^10.0.0": "^11.0.8"
  },
  "build": {
    "appId": "com.sadseal.sealpet",
    "productName": "Fok",
    "copyright": "Copyright © 2026 Sad_Seal",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fok"
    }
  }
}
